# -----------------------------------------------------------------------------
# Supabase (portfolio content: Hero, Projects, Skills, Experience, etc.)
# Dashboard: https://supabase.com/dashboard/project/olmodhsmoxzhzaagvyok
# Project URL format: https://<PROJECT_REF>.supabase.co  → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Optional: Storage bucket name when `image_url` stores only the object path (default: portfolio)
# NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=portfolio

# Optional: upload project screenshots (scripts/upload-project-images.mjs) — never commit this key
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional: canonical URL for Open Graph / metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Contact form (SMTP) — required for "Send a message" to email you
# Gmail: use App Password + smtp.gmail.com, port 587
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
# Where inbound messages are delivered (defaults to SMTP_USER)
# CONTACT_TO=your_email@gmail.com
# Optional custom From header
# SMTP_FROM="Portfolio" <your_email@gmail.com>

# -----------------------------------------------------------------------------
# AI chat: pick ONE primary mode with AI_PROVIDER
# - gemini     → plain Gemini (no vector DB)
# - qdrant     → RAG: Mistral embeddings + Qdrant retrieval + generator below
# - openrouter → direct OpenRouter (no RAG)
# -----------------------------------------------------------------------------
AI_PROVIDER=qdrant

# RAG answer generator (only when AI_PROVIDER=qdrant)
# - gemini     → needs GEMINI_API_KEY
# - openrouter → needs OPENROUTER_API_KEY
RAG_GENERATOR=gemini

# Google Gemini (plain chat when AI_PROVIDER=gemini, or RAG generator when RAG_GENERATOR=gemini)
GEMINI_API_KEY=your_gemini_api_key

# OpenRouter (optional: direct chat or RAG generator)
OPENROUTER_API_KEY=your_openrouter_api_key

# Mistral — embeddings for RAG (required when AI_PROVIDER=qdrant)
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_EMBED_MODEL=mistral-embed

# Qdrant Cloud (or self-hosted) — same cluster as sync script
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
# Optional; must match app + sync script (default: portfolio_vectors)
# QDRANT_COLLECTION=portfolio_vectors
